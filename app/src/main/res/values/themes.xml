<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main app theme - uses SplashScreen parent for installSplashScreen() API -->
    <style name="Theme.BpkpadPeminjaman" parent="Theme.SplashScreen">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- SplashScreen: icon background and animation -->
        <item name="windowSplashScreenBackground">@color/bpkpad_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BpkpadPeminjaman.App</item>
    </style>

    <!-- Actual running theme (used after splash dismisses) -->
    <style name="Theme.BpkpadPeminjaman.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>